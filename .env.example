# Keep this file free of real credentials. Load values through your shell or a local .env ignored by Git.
OPENROUTER_API_KEY=
# Set to a model available in your OpenRouter account. This is deliberately explicit for reproducibility.
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=MIRA-MAS
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0
OPENROUTER_REASONING_EFFORT=minimal
OPENROUTER_JSON_MODE=true
